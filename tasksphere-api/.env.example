PORT=3000
APP_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s

# Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=tasksphere
MONGO_TIMEOUT=10s

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-that-is-at-least-32-characters-long
ACCESS_EXPIRY_MIN=15
REFRESH_EXPIRY_HOUR=168

# Google Oauth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:4200/google/callback

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
OUTPUT_DIR=logs
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# Rate Limiting Configuration
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_COMMENT=30
RATE_LIMIT_WINDOW=5

# WebSocket Configuration
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_MAX_CONNECTIONS=1000

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr
BUNDLE_PATH="locales"